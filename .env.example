# ==========================================
# CẤU HÌNH NHÀ CUNG CẤP MÔ HÌNH LLM (SOC AGENT)
# ==========================================

# 1. Google Gemini (Mặc định)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.8-flash

# 2. Local LLM qua Ollama (Chạy offline, không giới hạn request, không lo 429)
# Bật Ollama: ollama run qwen2.5:7b-instruct
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b-instruct

# 3. Groq Cloud (Miễn phí, tốc độ cực nhanh ~300 tokens/s, không lo rate limit)
# Đăng ký lấy key tại: https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

