# ===================================================
# 🛡️ CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN AI SOC AGENT
# ===================================================
# Sao chép file này thành .env và điền các giá trị thực tế của bạn:
#   cp .env.example .env
# TUYỆT ĐỐI KHÔNG commit file .env chứa khóa thật lên Git!

# ---------------------------------------------------
# 1. Cấu hình Nhà cung cấp Mô hình LLM
# ---------------------------------------------------
# Lựa chọn: gemini | ollama | groq | openai
LLM_PROVIDER=gemini

# [Provider: Gemini]
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.8-flash

# [Provider: Local LLM qua Ollama] (Chạy 100% offline, không tốn phí, không dính 429)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b-instruct

# [Provider: Groq Cloud API] (Miễn phí, tốc độ cực nhanh ~300 tokens/s)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------
# 2. Cấu hình Kết nối Máy chủ Giám sát Linux (SSH Lab)
# ---------------------------------------------------
SSH_HOST=192.168.56.101
SSH_PORT=22
SSH_USER=agent_soc

# Xác thực bằng SSH Private Key (Khuyên dùng)
SSH_KEY_PATH=~/.ssh/soc_agent_key

# Hoặc xác thực bằng Mật khẩu (Bỏ comment nếu dùng)
# SSH_PASSWORD=your_secure_password_here
