# Dự án chạy 100% CỤC BỘ (AIR-GAPPED LOCAL OLLAMA)
# Không sử dụng Cloud API, không phụ thuộc kết nối Internet.

# 1. Cấu hình Local LLM qua Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_SEED=42
OLLAMA_TEMPERATURE=0.0

# 2. Cấu hình Kết nối Máy chủ Giám sát Linux (SSH Lab)
SSH_HOST=192.168.56.101
SSH_PORT=22
SSH_USER=agent_soc
SSH_KEY_PATH=~/.ssh/soc_agent_key
# SSH_PASSWORD=your_password_here (Tùy chọn nếu dùng mật khẩu thay vì SSH key)
