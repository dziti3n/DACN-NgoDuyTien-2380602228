# ===================================================
# 🛡️ CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN AI SOC AGENT
# ===================================================
# Lõi AI điều tra chạy 100% CỤC BỘ (LOCAL OLLAMA)
# Không gửi dữ liệu log ra ngoài Cloud API.

# 1. Cấu hình Local LLM qua Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_SEED=42
OLLAMA_TEMPERATURE=0.0

# 2. Cấu hình Kết nối Máy chủ Giám sát Linux (SSH Lab)
SSH_HOST=192.168.56.101
SSH_PORT=22
SSH_USER=agent_soc
SSH_KEY_PATH=~/.ssh/soc_agent_key
# SSH_PASSWORD=your_password_here (Tùy chọn nếu dùng mật khẩu thay vì SSH key)

# 3. Cấu hình Giám sát Tự hành (Autonomous SOAR Daemon)
# Chu kỳ thăm dò log tính bằng giây (mặc định: 20s)
MONITOR_POLL_INTERVAL=20
# Tự động cách ly IP qua UFW khi Agent xác nhận tấn công (true: Tự hành 100%, false: Chờ duyệt)
AUTO_BLOCK_ENABLED=true

# 4. Cấu hình Thông báo Email Cảnh báo Sự cố (Gmail SMTP)
# Bật/tắt gửi email thật (true/false). Nếu false hoặc chưa cấu hình, hệ thống sẽ lưu bản tin HTML vào runs/alerts/
ALERT_EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Địa chỉ Gmail người gửi và Mật khẩu ứng dụng (Google App Password 16 chữ số)
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
# Địa chỉ Gmail nhận cảnh báo (mặc định gửi tới chính bạn hoặc đội SOC)
RECIPIENT_EMAIL=your_email@gmail.com
